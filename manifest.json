{
  "manifest_version": 3,
  "name": "Redmine 2.0",
  "version": "1.0.8",
  "description": "Improves Redmine",
  "action": {
    "default_title": "Redmine 2.0"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tracker.sendpulse.com/*"],
      "js": ["history_watcher.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject_select2.js"],
      "matches": ["https://tracker.sendpulse.com/*"]
    }
  ]
}
